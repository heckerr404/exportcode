{
  "hosting": {
    "public": "frontend/dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      {
        "source": "/api/**",
        "function": "api"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "functions": [
    {
      "source": "backend",
      "codebase": "codesync-api",
      "ignore": ["node_modules", ".git", "data", ".env"],
      "predeploy": ["npm --prefix backend run build"]
    }
  ]
}
