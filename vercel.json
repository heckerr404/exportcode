{
  "version": 2,
  "buildCommand": "cd frontend && npm install && npm run build",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index" }
  ],
  "functions": {
    "backend/api/index.ts": {
      "runtime": "nodejs20.x",
      "maxDuration": 60
    }
  },
  "env": {
    "NODE_ENV": "production"
  }
}
